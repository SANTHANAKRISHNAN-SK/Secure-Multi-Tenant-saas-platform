# Copy to .env for local development (never commit the real .env).
# In ECS Fargate, these are set via the task definition's
# "environment" / "secrets" blocks instead of a .env file.

FLASK_ENV=production
FLASK_DEBUG=false
FLASK_SECRET_KEY=change-me-locally-only

# Set to "false" to use real AWS services (Cognito/RDS/Secrets Manager/KMS).
DEMO_MODE=true

SESSION_COOKIE_SECURE=true
SESSION_TTL_MINUTES=30

AWS_REGION=us-east-1

COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=us-east-1

# Hosted UI domain prefix only (no scheme/trailing slash), e.g.
# tenant-saas.auth.us-east-1.amazoncognito.com
COGNITO_DOMAIN=

# Must exactly match a "callback URL" configured on the App Client.
COGNITO_REDIRECT_URI=https://your-alb-domain.example.com/auth/callback

# Must exactly match a "sign-out URL" configured on the App Client.
COGNITO_LOGOUT_REDIRECT_URI=https://your-alb-domain.example.com/login

# aws.cognito.signin.user.admin is required for the self-service
# change_password() call in services/cognito_service.py to work; it
# authorizes the access token to call Cognito User Pool APIs.
COGNITO_SCOPES=openid email profile aws.cognito.signin.user.admin

# Only needed if the App Client was created WITH a client secret
# (confidential client). Leave blank for a public client using PKCE.
# In a real deployment this should come from Secrets Manager
# (key "COGNITO_APP_CLIENT_SECRET") instead of this env var -- see
# app.py -> load_runtime_secrets().
COGNITO_APP_CLIENT_SECRET=

# --- API Gateway + Cognito Authorizer trusted-header path (opt-in) ---
# Leave disabled until the real API Gateway mapping template exists
# and these values are confirmed to match it. See MIGRATION_REVIEW.md
# section 3 and decorators.py for the full contract. Only affects
# programmatic API clients hitting the JSON endpoints directly with a
# bearer JWT; the browser Hosted-UI/session flow is unaffected either way.
API_GATEWAY_TRUSTED_HEADERS_ENABLED=false
API_GW_SHARED_SECRET=
API_GW_SECRET_HEADER_NAME=X-Api-Gateway-Secret
API_GW_SUB_HEADER_NAME=X-Amzn-Cognito-Sub
API_GW_USERNAME_HEADER_NAME=X-Amzn-Cognito-Username
API_GW_EMAIL_HEADER_NAME=X-Amzn-Cognito-Email
API_GW_GROUPS_HEADER_NAME=X-Amzn-Cognito-Groups

SECRETS_MANAGER_SECRET_NAME=tenant-saas/prod/app-secrets

KMS_KEY_ID=

RDS_HOST=localhost
RDS_PORT=3306
RDS_DB_NAME=tenant_saas
RDS_CONNECT_TIMEOUT=5

LOG_GROUP_NAME=/ecs/tenant-saas-app
LOG_LEVEL=INFO
